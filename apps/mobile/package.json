{
  "name": "openrator",
  "description": "OpenRator — single-pane OpenRouter dashboard for Android (Expo/React Native).",
  "license": "0BSD",
  "version": "0.2.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.25",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "^15.15.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "~19.2.2",
    "potrace": "^2.1.8",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "acceptance": "ACCEPTANCE_REPORT=1 vitest run tests/acceptance.test.ts",
    "acceptance:check": "ACCEPTANCE_VERIFY=1 vitest run tests/acceptance.test.ts",
    "acceptance:evidence": "vitest run tests/device-evidence.test.ts",
    "evidence:init": "EVIDENCE_RENDER=1 vitest run tests/device-run.test.ts",
    "release:check": "vitest run tests/release.test.ts",
    "typecheck": "tsc --noEmit",
    "assets:build": "node ../../scripts/brand/build-assets.mjs",
    "assets:check": "node ../../scripts/brand/build-assets.mjs --check"
  }
}
